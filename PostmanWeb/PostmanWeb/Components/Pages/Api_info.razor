@page "/api"
@rendermode InteractiveServer
@inject NavigationManager NavManager

<PageTitle>Api Infos</PageTitle>

<div class="text-center border-bottom pb-3 mb-4">
    <div class="d-flex justify-content-center align-items-center gap-4">
        <h1 class="h2 fw-bold mb-0 text-primary">APIs Info</h1>
    </div>
</div>

<ul class="nav nav-pills custom-pills justify-content-center mb-4 gap-2">
    <li class="nav-item">
        <button class="nav-link @(activeTab == "apis" ? "active" : "")"
                @onclick='() => activeTab = "apis"'>
            <i class="me-1"></i>APIS for testing
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "codes" ? "active" : "")"
                @onclick='() => activeTab = "codes"'>
            <i class="me-1"></i>HTTP codes
        </button>
    </li>
</ul>

<div class="container mt-4">
    @if(activeTab == "apis")
    {
        <div class="card p-4 shadow-sm border-0">
            <h3 class="mb-3">API tests</h3>
            <p class="text-muted">Your Endpoint list: </p>

            <div class="list-group">
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span><code>GET</code> https://api.example.com/status</span>
                    <span class="bagde bg-success">Functional</span>
                </div>
            </div>
        </div>
    }
    else if(activeTab=="codes")
    {
        <div class="card p-4 shadow-sm border-0">
            <h3 class="mb-3">HTTP common codes</h3>
            <p class="text-muted">Debugging guide:</p>

            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Meaning</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="badge bg-success">200</span></td>
                        <td><strong>OK</strong> - Request succeded</td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-warning text-dark">400</span></td>
                        <td><strong>Bad Request</strong> - Wrong data.</td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-danger">500</span></td>
                        <td><strong>Internal Server Error</strong> - Server error.</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="card p-4 shadow-sm border-0">
            <h3 class="mb-3">General meaning</h3>
            <p class="alert-info">status codes</p>

            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>HTTP code</th>
                        <th>Meaning</th> 
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="badge bg-primary">1xx</span></td>
                        <td><strong>Informational</strong> - Request succeded</td>

                    </tr>
                    <tr>
                        <td><span class="badge bg-primary">2xx</span></td>
                        <td><strong>Success</strong> - Request succeded</td>

                    </tr>
                    <tr>
                        <td><span class="badge bg-primary">3xx</span></td>
                        <td><strong>Redirection</strong> - Request succeded</td>

                    </tr>
                    <tr>
                        <td><span class="badge bg-primary">4xx</span></td>
                        <td><strong>Client errors</strong> - Request succeded</td>

                    </tr>
                    <tr>
                        <td><span class="badge bg-primary">5xx</span></td>
                        <td><strong>Server errors</strong> - Request succeded</td>

                    </tr>
                </tbody>
            </table>
        </div>

    }
</div>

@code {
    private string activeTab = "apis";
}