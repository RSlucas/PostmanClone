@page "/"
@using PostmanCloneLib
@using System.Diagnostics
@inject IApiAcces api

<PageTitle>Postman Clone</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">Postman Clone</h1>

    <!-- Bara de control: Metodă + URL + Buton -->
    <div class="input-group mb-3">
        <select class="form-select" style="max-width: 130px;" @bind="selectedAction">
            @foreach (var action in Enum.GetValues<HttpAction>())
            {
                <option value="@action">@action</option>
            }
        </select>

        <input class="form-control" placeholder="Introdu URL-ul (ex: https://jsonplaceholder.typicode.com/todos/1)..." type="url" @bind="apiUrl" />

        <button class="btn btn-primary px-4" @onclick="CallApi" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Calling...</span>
            }
            else
            {
                <span>Call</span>
            }
        </button>
    </div>

    <!-- Bara de Status și Timp de răspuns -->
    <div class="d-flex gap-3 align-items-center mb-3">
        <span class="badge @GetStatusBadgeClass() p-2">Status: @status</span>
        @if (sw.ElapsedMilliseconds > 0)
        {
            <span class="badge bg-secondary p-2">Timp: @sw.ElapsedMilliseconds ms</span>
        }
    </div>

    <!-- Zona Body și Rezultate -->
    <div class="row g-3">
        <div class="col-md-5">
            <label class="form-label fw-bold">Body JSON</label>
            <textarea class="form-control bg-light font-monospace"
                      style="min-height: 250px;"
                      placeholder="Introdu JSON-ul pentru POST / PUT / PATCH..."
                      disabled="@(selectedAction == HttpAction.GET)"
                      @bind="bodyText"></textarea>
        </div>

        <div class="col-md-7">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label fw-bold mb-0">Results</label>
                @if (!string.IsNullOrWhiteSpace(resultsText))
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => resultsText = string.Empty">Clear</button>
                }
            </div>
            <pre class="form-control bg-light font-monospace overflow-auto"
                 style="min-height: 250px; max-height: 450px; white-space: pre-wrap;">@resultsText</pre>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "testUrl")]
    public string? TestUrl { get; set; }

    private string apiUrl = "";
    private string status = "Idle";
    private string bodyText = "";
    private string resultsText = "";
    private bool isLoading = false;

    private HttpAction selectedAction = HttpAction.GET;
    private Stopwatch sw = new();

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(TestUrl))
        {
            apiUrl = TestUrl;
        }
    }

    private async Task CallApi()
    {
        if (!api.IsValidUrl(apiUrl))
        {
            status = "Invalid URL";
            return;
        }

        try
        {
            isLoading = true;
            status = "Calling API...";
            resultsText = "";
            sw.Restart();

            resultsText = await api.CallApiAsync(apiUrl, bodyText, selectedAction);

            sw.Stop();
            status = "Ready (200 OK)";
        }
        catch (Exception ex)
        {
            sw.Stop();
            resultsText = $"Error: {ex.Message}";
            status = "Error";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusBadgeClass() => status switch
    {
        "Ready (200 OK)" => "bg-success",
        "Error" or "Invalid URL" => "bg-danger",
        "Calling API..." => "bg-warning text-dark",
        _ => "bg-info text-dark"
    };
}