@page "/"
@using PostmanCloneLib
@inject IApiAcces api
@using System.Diagnostics

<PageTitle>Home</PageTitle>

<h1>Postman Clone</h1>

<div class="input-group mb-lg-3">
    <input class="form-control" placeholder="Insert your URL..." style="max-width: 400px" type="url" @bind="apiUrl" />
    <button class="btn btn-primary" @onclick="CallApi">Call</button>

    <select class="form-select-lg"  style="max-width: 120px" @bind="selectedAction">
        <option value="@HttpAction.GET">GET</option>
        <option value="@HttpAction.POST">POST</option>
        <option value="@HttpAction.PUT">PUT</option>
        <option value="@HttpAction.PATCH">PATCH</option>
        <option value="@HttpAction.DELETE">DELETE</option>

    </select>

</div>

<div class="row">
    <div class="col-md-3">
        <label class="form-label fw-bold">Body JSON</label>
        <textarea class="form-control bg-light" style="min-height:150px; " rows="6" placeholder="Json...">@bodyText</textarea>
    </div>
    <div class="col-md 3">
        <label class="form-label fw-bold">Results</label>
        <pre class="form-control bg-light navbar" style="min-height:150px; max-height:300px;max-width:500px; white-space:pre-wrap; min-width:500px">@resultsText</pre>
    </div>
</div>

<pre>Status: @status</pre>
<pre>@sw</pre>

@code{
    private string apiUrl = "";
    private string status = "";

    private HttpAction selectedAction = HttpAction.GET;

    string bodyText = "";
    string resultsText = "";

    private Stopwatch sw = new Stopwatch();

    private async Task CallApi()
    {

        status = "calling api...";

        if(api.IsValidUrl(apiUrl) == false)
        {
            status = "Error";
            return;
        }



        try
        {
            status = "calling api";
            sw.Restart();

            resultsText = await api.CallApiAsync(apiUrl, bodyText, selectedAction);

            sw.Stop();
            status = "Ready!";
        }
        catch(Exception ex)
        {
            sw.Stop();
            resultsText = $"Error: {ex.Message}";
            status = "Error";
        }

    }
}
