@page "/"
@using PostmanCloneLib
@inject IApiAcces api


<PageTitle>Home</PageTitle>

<h1>Postman Clone</h1>
<input type="url" @bind="apiUrl"/>
<button @onclick="CallApi">Call</button>

<select @bind="selectedAction">
    <option value="@HttpAction.GET">GET</option>
    <option value="@HttpAction.POST">POST</option>
</select>


<textarea>@resultsText</textarea>

<p>@status</p>

@code{
    private string apiUrl = "";
    private string status = "";

    private HttpAction selectedAction = HttpAction.GET;

    string bodyText = "";
    string resultsText = "";

    private async Task CallApi()
    {
        status = "Calling Api";

        if(api.IsValidUrl(apiUrl) == false)
        {
            status = "Invalid URL";
            return;
        }

        HttpAction action;

        if(Enum.TryParse(selectedAction.ToString(), out action) == false)
        {
            status = "Invalid HTTP Verb!";
        }

        try
        {
            status = "Calling API";
            resultsText = await api.CallApiAsync(apiUrl, bodyText, selectedAction);
            status = "Ready!";
        }
        catch(Exception ex)
        {
            resultsText = $"Error: {ex.Message}";
            status = "Error";
        }

    }
}
