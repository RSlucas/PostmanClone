@page "/"
@using PostmanCloneLib
@inject IApiAcces api
@using System.Diagnostics

<PageTitle>Home</PageTitle>

<h1>Postman Clone</h1>

<div class="container mt-4">
    <h1 class="mb-4">Postman Clone</h1>

    <div class="input-group mb-3">
        <select class="form-select" style="max-width:130px;" @bind="selectedAction">
            @foreach (var action in Enum.GetValues<HttpAction>())
            {
                <option value="@action">@action</option>
            }
        </select>
        <input class="form-control" placeholder="Insert your URL..." style="max-width: 400px" type="url" @bind="apiUrl" input />

        <button class="btn btn-primary px-4" @onclick="CallApi" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Calling Api..</span>
            }
            else
            {
                <span>Call</span>
            }
        </button>
    </div>

    <div class="d-flex gap-3 align-items-center mb-3">
        <span class="badge @GetStatusBadgeClass() p-2">Status: @status</span>
        @if (sw.ElapsedMilliseconds > 0)
        {
            <span class="badge bg-secondary p-2">Timp: @sw.ElapsedMilliseconds ms</span>
        }
    </div>
    

</div>

<div class="row">
    <div class="col-md-3">
        <label class="form-label fw-bold">Body JSON</label>
        <textarea class="form-control bg-light" style="min-height:150px; " rows="6" placeholder="Json..." @bind="bodyText"></textarea>
    </div>
    <div class="col-md 3">
        <label class="form-label fw-bold">Results</label>
        <pre class="form-control bg-light navbar" style="min-height:150px; max-height:300px;max-width:500px; white-space:pre-wrap; min-width:500px">@resultsText</pre>
    </div>
</div>

<pre>Status: @status</pre>
<pre>@sw</pre>

@code{
    private string apiUrl = "";
    private string status = "";

    private HttpAction selectedAction = HttpAction.GET;

    string bodyText = "";
    string resultsText = "";
    private bool isLoading = false;

    private Stopwatch sw = new Stopwatch();

    private async Task CallApi()
    {

        status = "calling api...";

        if(api.IsValidUrl(apiUrl) == false)
        {
            status = "Error";
            return;
        }



        try
        {
            status = "calling api";
            sw.Restart();

            resultsText = await api.CallApiAsync(apiUrl, bodyText, selectedAction);

            sw.Stop();
            status = "Ready!";
        }
        catch(Exception ex)
        {
            sw.Stop();
            resultsText = $"Error: {ex.Message}";
            status = "Error";
        }

    }

    private string GetStatusBadgeClass() => status switch
    {
        "Ready (200 OK)" => "bg-success",
        "Error" or "Invalid URL" => "bg-danger",
        "Calling API..." => "bg-warning text-dark",
        _ => "bg-info text-dark"
    };

}
